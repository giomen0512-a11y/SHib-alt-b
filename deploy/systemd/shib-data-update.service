[Unit]
Description=SHib finite closed Futures minute update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/SHib-alt-b
Environment=TRADING_MODE=STOPPED
EnvironmentFile=/etc/shib-alt-b/data.env
ExecStartPre=/usr/bin/test -s ${SHIB_DATA_DB}
ExecStart=/home/ubuntu/SHib-alt-b/.venv/bin/python -m trading_engine.market_data.cli update-once --db-path ${SHIB_DATA_DB} --publication-delay-seconds ${SHIB_DATA_DELAY_SECONDS} --max-update-minutes ${SHIB_DATA_MAX_UPDATE_MINUTES} --min-free-mib ${SHIB_DATA_RESERVE_MIB} --request-interval-seconds ${SHIB_DATA_REQUEST_INTERVAL_SECONDS}
TimeoutStartSec=10min
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shib-alt-b
MemoryMax=768M
CPUQuota=100%
StandardOutput=journal
StandardError=journal
